//Se utiliza para administrar el reabastecimiento de Materia Prima.

package cafe;
import java.awt.*; import javax.swing.*; import javax.swing.table.DefaultTableModel;
public class ReabastecimientoFrame extends LayoutBase{
 DefaultTableModel modelo; JTable tabla; JLabel totalLbl; double total=0;
 public ReabastecimientoFrame(){super("Reabastecimiento"); ui();}
 void ui(){JPanel top=new JPanel(new BorderLayout()); top.setBackground(Estilos.CREMA); top.add(Estilos.titulo("Reabastecimiento"),BorderLayout.WEST); JButton nuevo=Estilos.boton("+ Nuevo Reabastecimiento",Estilos.AMARILLO); nuevo.addActionListener(e->agregar()); top.add(nuevo,BorderLayout.EAST); modelo=new DefaultTableModel(new String[]{"Materia Prima","Cantidad","Precio Unit.","Subtotal","Acciones"},0); tabla=new JTable(modelo); tabla.setRowHeight(30); totalLbl=new JLabel("TOTAL: $0.00",SwingConstants.RIGHT); totalLbl.setFont(new Font("Segoe UI",Font.BOLD,25)); totalLbl.setForeground(Estilos.VERDE); JButton add=Estilos.boton("Agregar Insumo",Estilos.VERDE); add.addActionListener(e->agregar()); JButton save=Estilos.boton("Guardar Reabastecimiento",Estilos.VERDE); save.addActionListener(e->guardar()); JPanel botones=new JPanel(); botones.setBackground(Estilos.CREMA); botones.add(add); botones.add(save); JPanel sur=new JPanel(new BorderLayout()); sur.setBackground(Estilos.CREMA); sur.add(totalLbl,BorderLayout.NORTH); sur.add(botones,BorderLayout.SOUTH); contenido.add(top,BorderLayout.NORTH); contenido.add(new JScrollPane(tabla)); contenido.add(sur,BorderLayout.SOUTH);}
 void agregar(){JTextField n=new JTextField(),c=new JTextField(),p=new JTextField(); Object[] campos={"Materia prima:",n,"Cantidad:",c,"Precio unitario:",p}; if(JOptionPane.showConfirmDialog(this,campos,"Agregar insumo",JOptionPane.OK_CANCEL_OPTION)==0) try{double cant=Double.parseDouble(c.getText()),pre=Double.parseDouble(p.getText()),sub=cant*pre; modelo.addRow(new Object[]{n.getText(),cant,pre,sub,"Eliminar"}); total+=sub; totalLbl.setText(String.format("TOTAL: $%.2f",total));}catch(Exception ex){JOptionPane.showMessageDialog(this,"Cantidad y precio deben ser numéricos.");}}
 void guardar(){if(modelo.getRowCount()==0){JOptionPane.showMessageDialog(this,"Agrega al menos un insumo.");return;} JOptionPane.showMessageDialog(this,"Reabastecimiento guardado. Total: $"+String.format("%.2f",total)); modelo.setRowCount(0); total=0; totalLbl.setText("TOTAL: $0.00");}
}
