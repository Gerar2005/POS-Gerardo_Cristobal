//Este módulo se utiliza para llevar un registro y manejo de los ingredientes utyilizados para preparar los postres que ofrece este negocio.

package cafe;
import java.awt.*; import java.sql.*; import javax.swing.*;
public class MateriaPrimaFrame extends LayoutBase{
 JPanel grid; JTextField buscar;
 public MateriaPrimaFrame(){super("Materia Prima"); ui(); cargar("");}
 void ui(){JPanel top=new JPanel(new BorderLayout(8,8)); top.setBackground(Estilos.CREMA); top.add(Estilos.titulo("Materia Prima"),BorderLayout.WEST); JButton nuevo=Estilos.boton("+ Nueva Materia Prima",Estilos.AMARILLO); nuevo.addActionListener(e->form(0,"","","")); top.add(nuevo,BorderLayout.EAST); buscar=Estilos.campo("Buscar materia prima"); JButton b=Estilos.boton("Buscar",Estilos.VERDE); b.addActionListener(e->cargar(buscar.getText())); JPanel bp=new JPanel(new BorderLayout(5,5)); bp.setBackground(Estilos.CREMA); bp.add(buscar); bp.add(b,BorderLayout.EAST); top.add(bp,BorderLayout.SOUTH); grid=new JPanel(new GridLayout(0,5,15,15)); grid.setBackground(Estilos.CREMA); contenido.add(top,BorderLayout.NORTH); contenido.add(new JScrollPane(grid));}
 void cargar(String f){grid.removeAll(); try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement("SELECT * FROM materia_prima WHERE nombre LIKE ?")){ps.setString(1,"%"+f+"%"); ResultSet rs=ps.executeQuery(); while(rs.next()) grid.add(card(rs.getInt(1),rs.getString(2),rs.getString(3),rs.getString(4)));}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());} grid.revalidate(); grid.repaint();}
 JPanel card(int id,String n,String cant,String est){JPanel p=new JPanel(new GridLayout(6,1)); p.setBackground(new Color(255,250,240)); p.setBorder(BorderFactory.createLineBorder(new Color(220,210,190))); p.add(new JLabel("☕",SwingConstants.CENTER)); JLabel ln=new JLabel(n,SwingConstants.CENTER); ln.setFont(new Font("Segoe UI",Font.BOLD,16)); p.add(ln); p.add(new JLabel("Cantidad",SwingConstants.CENTER)); p.add(new JLabel(cant,SwingConstants.CENTER)); JLabel le=new JLabel(est,SwingConstants.CENTER); le.setOpaque(true); le.setBackground(est.toLowerCase().contains("bajo")?new Color(255,190,100):new Color(221,241,199)); p.add(le); JButton e= new JButton("Editar"); e.addActionListener(x->form(id,n,cant,est)); p.add(e); return p;}
 void form(int id,String n,String canti,String est){JTextField n1=new JTextField(n),c1=new JTextField(canti),e1=new JTextField(est); Object[] campos={"Nombre:",n1,"Cantidad:",c1,"Estado:",e1}; if(JOptionPane.showConfirmDialog(this,campos,id==0?"Nueva Materia Prima":"Editar Materia Prima",JOptionPane.OK_CANCEL_OPTION)==0) guardar(id,n1.getText(),c1.getText(),e1.getText());}
 void guardar(int id,String n,String cant,String est){String sql=id==0?"INSERT INTO materia_prima(nombre,cantidad,estado) VALUES(?,?,?)":"UPDATE materia_prima SET nombre=?,cantidad=?,estado=? WHERE id_materia=?"; try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement(sql)){ps.setString(1,n);ps.setString(2,cant);ps.setString(3,est); if(id!=0)ps.setInt(4,id); ps.executeUpdate(); cargar("");}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
}
