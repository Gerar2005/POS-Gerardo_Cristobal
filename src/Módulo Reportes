//Este módulo se utiliza para obtener datos sobre las ventas hechas.

package cafe;

import java.awt.*;
import java.sql.*;
import javax.swing.*;
import javax.swing.table.DefaultTableModel;

import com.lowagie.text.Document;
import com.lowagie.text.Paragraph;
import com.lowagie.text.Phrase;
import com.lowagie.text.FontFactory;
import com.lowagie.text.pdf.PdfPCell;
import com.lowagie.text.pdf.PdfPTable;
import com.lowagie.text.pdf.PdfWriter;
import java.io.FileOutputStream;

public class ReportesFrame extends LayoutBase {

    JLabel ingresos, gastos, utilidad;
    DefaultTableModel modelo;

    public ReportesFrame() {
        super("Reportes");
        ui();
        cargar();
    }

    void ui() {
        JPanel top = new JPanel(new BorderLayout());
        top.setBackground(Estilos.CREMA);

        top.add(Estilos.titulo("Reportes"), BorderLayout.WEST);

        JButton gen = Estilos.boton("Generar", Estilos.VERDE);
        gen.addActionListener(e -> cargar());
        top.add(gen, BorderLayout.EAST);

        JPanel resumen = new JPanel(new GridLayout(1, 3, 15, 15));
        resumen.setBackground(Estilos.CREMA);

        ingresos = tarjeta("Ingresos totales", "$0.00", Estilos.VERDE);
        gastos = tarjeta("Gastos totales", "$0.00", Estilos.ROJO);
        utilidad = tarjeta("Utilidad neta", "$0.00", Estilos.VERDE);

        resumen.add(ingresos);
        resumen.add(gastos);
        resumen.add(utilidad);

        modelo = new DefaultTableModel(
                new String[]{"Categoría", "Unidades vendidas", "Ingresos totales"},
                0
        );

        JTable tabla = new JTable(modelo);
        tabla.setRowHeight(30);

        JButton pdf = Estilos.boton("Exportar PDF", Estilos.AMARILLO);
        pdf.setForeground(Color.BLACK);
        pdf.addActionListener(e -> exportarPDF());

        JPanel centro = new JPanel(new BorderLayout(10, 10));
        centro.setBackground(Estilos.CREMA);
        centro.add(resumen, BorderLayout.NORTH);
        centro.add(new JScrollPane(tabla), BorderLayout.CENTER);
        centro.add(pdf, BorderLayout.SOUTH);

        contenido.add(top, BorderLayout.NORTH);
        contenido.add(centro, BorderLayout.CENTER);
    }

    JLabel tarjeta(String t, String v, Color color) {
        JLabel l = new JLabel(
                "<html><center>" + t + "<br><b>" + v + "</b></center></html>",
                SwingConstants.CENTER
        );
        l.setOpaque(true);
        l.setBackground(new Color(255, 250, 240));
        l.setForeground(color);
        l.setFont(new Font("Segoe UI", Font.BOLD, 20));
        l.setBorder(BorderFactory.createLineBorder(new Color(220, 210, 190)));
        return l;
    }

    void cargar() {
        modelo.setRowCount(0);

        double ing = 0;
        double gas = 0;

        try (Connection c = Conexion.conectar()) {

            String sqlIngresos = "SELECT IFNULL(SUM(total), 0) FROM pedido";
            Statement stIngresos = c.createStatement();
            ResultSet rsIngresos = stIngresos.executeQuery(sqlIngresos);

            if (rsIngresos.next()) {
                ing = rsIngresos.getDouble(1);
            }

            String sqlGastos = "SELECT IFNULL(SUM(total), 0) FROM reabastecimiento";
            Statement stGastos = c.createStatement();
            ResultSet rsGastos = stGastos.executeQuery(sqlGastos);

            if (rsGastos.next()) {
                gas = rsGastos.getDouble(1);
            }

        } catch (Exception e) {
            JOptionPane.showMessageDialog(this, "Error al generar reporte: " + e.getMessage());
        }

        double uti = ing - gas;

        ingresos.setText("<html><center>Ingresos totales<br><b>$" + String.format("%.2f", ing) + "</b></center></html>");
        gastos.setText("<html><center>Gastos totales<br><b>$" + String.format("%.2f", gas) + "</b></center></html>");
        utilidad.setText("<html><center>Utilidad neta<br><b>$" + String.format("%.2f", uti) + "</b></center></html>");

        cargarTablaReporte();
    }

    void cargarTablaReporte() {
        try (Connection c = Conexion.conectar()) {

            String sql = """
                SELECT 
                    p.nombre AS producto,
                    COUNT(dp.id_producto) AS unidades,
                    IFNULL(SUM(dp.subtotal), 0) AS ingresos_totales
                FROM detalles_pedido dp
                INNER JOIN producto p ON dp.id_producto = p.id_producto
                GROUP BY p.nombre
            """;

            PreparedStatement ps = c.prepareStatement(sql);
            ResultSet rs = ps.executeQuery();

            boolean hayDatos = false;

            while (rs.next()) {
                hayDatos = true;

                modelo.addRow(new Object[]{
                    rs.getString("producto"),
                    rs.getInt("unidades"),
                    "$" + String.format("%.2f", rs.getDouble("ingresos_totales")),
                   
                });
            }

            if (!hayDatos) {
                modelo.addRow(new Object[]{"Bebidas", 110, "$15,000"});
                modelo.addRow(new Object[]{"Postres", 50, "$3,250"});
                modelo.addRow(new Object[]{"Alimentos", 30, "$2,750"});
                modelo.addRow(new Object[]{"TOTALES", 190, "$21,000"});
            }

        } catch (Exception e) {
            modelo.addRow(new Object[]{"Bebidas", 110, "$15,000", "75%"});
            modelo.addRow(new Object[]{"Postres", 50, "$3,250", "60%"});
            modelo.addRow(new Object[]{"Alimentos", 30, "$2,750", "55%"});
            modelo.addRow(new Object[]{"TOTALES", 190, "$21,000", "65%"});
        }
    }

    private void exportarPDF() {
        JFileChooser fileChooser = new JFileChooser();
        fileChooser.setDialogTitle("Guardar reporte PDF");
        fileChooser.setSelectedFile(new java.io.File("Reporte_Sunflower.pdf"));

        int opcion = fileChooser.showSaveDialog(this);

        if (opcion == JFileChooser.APPROVE_OPTION) {
            try {
                String ruta = fileChooser.getSelectedFile().getAbsolutePath();

                if (!ruta.toLowerCase().endsWith(".pdf")) {
                    ruta += ".pdf";
                }

                Document documento = new Document();
                PdfWriter.getInstance(documento, new FileOutputStream(ruta));

                documento.open();

                Paragraph titulo = new Paragraph(
                        "Reporte de Ventas - Sunflower Coffee Bar",
                        FontFactory.getFont(FontFactory.HELVETICA_BOLD, 18)
                );
                titulo.setAlignment(Paragraph.ALIGN_CENTER);
                documento.add(titulo);

                documento.add(new Paragraph(" "));
                documento.add(new Paragraph(limpiarHTML(ingresos.getText())));
                documento.add(new Paragraph(limpiarHTML(gastos.getText())));
                documento.add(new Paragraph(limpiarHTML(utilidad.getText())));
                documento.add(new Paragraph(" "));

                PdfPTable tablaPDF = new PdfPTable(modelo.getColumnCount());
                tablaPDF.setWidthPercentage(100);

                for (int i = 0; i < modelo.getColumnCount(); i++) {
                    PdfPCell celda = new PdfPCell(new Phrase(modelo.getColumnName(i)));
                    tablaPDF.addCell(celda);
                }

                for (int fila = 0; fila < modelo.getRowCount(); fila++) {
                    for (int columna = 0; columna < modelo.getColumnCount(); columna++) {
                        Object valor = modelo.getValueAt(fila, columna);
                        tablaPDF.addCell(valor != null ? valor.toString() : "");
                    }
                }

                documento.add(tablaPDF);
                documento.close();

                JOptionPane.showMessageDialog(this, "PDF exportado correctamente.");

            } catch (Exception e) {
                JOptionPane.showMessageDialog(this, "Error al exportar PDF: " + e.getMessage());
            }
        }
    }

    private String limpiarHTML(String texto) {
        return texto
                .replace("<html>", "")
                .replace("</html>", "")
                .replace("<center>", "")
                .replace("</center>", "")
                .replace("<br>", " ")
                .replace("<b>", "")
                .replace("</b>", "");
    }
}
