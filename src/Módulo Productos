//Este módulo se utiliza para agregar productos al menú del negocio

package cafe;
import java.awt.*; import java.sql.*; import javax.swing.*; import javax.swing.table.DefaultTableModel;
public class ProductosFrame extends LayoutBase{
 DefaultTableModel modelo; JTable tabla; JTextField buscar;
 public ProductosFrame(){super("Productos"); ui(); cargar("");}
 void ui(){JPanel top=new JPanel(new BorderLayout(8,8)); top.setBackground(Estilos.CREMA); top.add(Estilos.titulo("Productos"),BorderLayout.WEST); JButton nuevo=Estilos.boton("+ Nuevo Producto",Estilos.AMARILLO); nuevo.addActionListener(e->form(0,"",0)); top.add(nuevo,BorderLayout.EAST); buscar=Estilos.campo("Buscar producto"); JButton bb=Estilos.boton("Buscar",Estilos.VERDE); bb.addActionListener(e->cargar(buscar.getText())); JPanel bp=new JPanel(new BorderLayout(5,5)); bp.setBackground(Estilos.CREMA); bp.add(buscar); bp.add(bb,BorderLayout.EAST); top.add(bp,BorderLayout.SOUTH); modelo=new DefaultTableModel(new String[]{"ID Producto","Nombre","Precio","Acciones"},0); tabla=new JTable(modelo); tabla.setRowHeight(30); JPanel acc=new JPanel(); acc.setBackground(Estilos.CREMA); JButton edit=Estilos.boton("Editar seleccionado",Estilos.AMARILLO),del=Estilos.boton("Eliminar seleccionado",Estilos.ROJO); edit.addActionListener(e->editar()); del.addActionListener(e->eliminar()); acc.add(edit); acc.add(del); contenido.add(top,BorderLayout.NORTH); contenido.add(new JScrollPane(tabla)); contenido.add(acc,BorderLayout.SOUTH);}
 void cargar(String f){modelo.setRowCount(0); try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement("SELECT * FROM producto WHERE nombre LIKE ?")){ps.setString(1,"%"+f+"%"); ResultSet rs=ps.executeQuery(); while(rs.next()) modelo.addRow(new Object[]{rs.getInt("id_producto"),rs.getString("nombre"),rs.getDouble("precio"),"Editar / Eliminar"});}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
 void form(int id,String n,double p){JTextField tn=new JTextField(n),tp=new JTextField(String.valueOf(p)); Object[] campos={"Nombre:",tn,"Precio:",tp}; if(JOptionPane.showConfirmDialog(this,campos,id==0?"Nuevo Producto":"Editar Producto",JOptionPane.OK_CANCEL_OPTION)==0) try{guardar(id,tn.getText(),Double.parseDouble(tp.getText()));}catch(Exception ex){JOptionPane.showMessageDialog(this,"El precio debe ser numérico.");}}
 void guardar(int id,String n,double p){String sql=id==0?"INSERT INTO producto(nombre,precio) VALUES(?,?)":"UPDATE producto SET nombre=?,precio=? WHERE id_producto=?"; try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement(sql)){ps.setString(1,n);ps.setDouble(2,p); if(id!=0)ps.setInt(3,id); ps.executeUpdate(); cargar("");}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
 void editar(){int r=tabla.getSelectedRow(); if(r<0){JOptionPane.showMessageDialog(this,"Selecciona un producto.");return;} form((int)modelo.getValueAt(r,0),modelo.getValueAt(r,1).toString(),Double.parseDouble(modelo.getValueAt(r,2).toString()));}
 void eliminar(){int r=tabla.getSelectedRow(); if(r<0){JOptionPane.showMessageDialog(this,"Selecciona un producto.");return;} if(JOptionPane.showConfirmDialog(this,"¿Eliminar producto?")==0) try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement("DELETE FROM producto WHERE id_producto=?")){ps.setInt(1,(int)modelo.getValueAt(r,0)); ps.executeUpdate(); cargar("");}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
}
