//Modulo Clientes. Está parte del código sirve para registrar a los clientes desde el software a la base de datos:

package cafe;

import java.awt.*; import java.sql.*; import javax.swing.*; import javax.swing.table.DefaultTableModel;
public class ClientesFrame extends LayoutBase{
 DefaultTableModel modelo; JTable tabla; JTextField buscar;
 public ClientesFrame(){super("Clientes"); ui(); cargar("");}
 void ui(){JPanel top=new JPanel(new BorderLayout(8,8)); top.setBackground(Estilos.CREMA); top.add(Estilos.titulo("Clientes"),BorderLayout.WEST); JButton nuevo=Estilos.boton("+ Nuevo Cliente",Estilos.AMARILLO); nuevo.addActionListener(e->form(0,"","","")); top.add(nuevo,BorderLayout.EAST); buscar=Estilos.campo("Buscar cliente"); JButton b=Estilos.boton("Buscar",Estilos.VERDE); b.addActionListener(e->cargar(buscar.getText())); JPanel bp=new JPanel(new BorderLayout(5,5)); bp.setBackground(Estilos.CREMA); bp.add(buscar); bp.add(b,BorderLayout.EAST); top.add(bp,BorderLayout.SOUTH); modelo=new DefaultTableModel(new String[]{"ID","Nombre","Apellido","Teléfono","Acciones"},0); tabla=new JTable(modelo); tabla.setRowHeight(30); JPanel acc=new JPanel(); acc.setBackground(Estilos.CREMA); JButton edit=Estilos.boton("Editar seleccionado",Estilos.AMARILLO), del=Estilos.boton("Eliminar seleccionado",Estilos.ROJO); edit.addActionListener(e->editar()); del.addActionListener(e->eliminar()); acc.add(edit); acc.add(del); contenido.add(top,BorderLayout.NORTH); contenido.add(new JScrollPane(tabla)); contenido.add(acc,BorderLayout.SOUTH);} 
 void cargar(String f){modelo.setRowCount(0); String sql="SELECT * FROM cliente WHERE nombre LIKE ? OR apellido LIKE ? OR telefono LIKE ?"; try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement(sql)){String x="%"+f+"%"; ps.setString(1,x); ps.setString(2,x); ps.setString(3,x); ResultSet rs=ps.executeQuery(); while(rs.next()) modelo.addRow(new Object[]{rs.getInt(1),rs.getString(2),rs.getString(3),rs.getString(4),"Editar / Eliminar"});}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
 void form(int id,String n,String a,String t){JTextField tn=new JTextField(n),ta=new JTextField(a),tt=new JTextField(t); Object[] campos={"Nombre:",tn,"Apellido:",ta,"Teléfono:",tt}; if(JOptionPane.showConfirmDialog(this,campos,id==0?"Nuevo Cliente":"Editar Cliente",JOptionPane.OK_CANCEL_OPTION)==0){ if(tn.getText().trim().isEmpty()||ta.getText().trim().isEmpty()||tt.getText().trim().isEmpty()){JOptionPane.showMessageDialog(this,"Todos los campos son obligatorios.");return;} guardar(id,tn.getText(),ta.getText(),tt.getText());}}
 void guardar(int id,String n,String a,String t){String sql=id==0?"INSERT INTO cliente(nombre,apellido,telefono) VALUES(?,?,?)":"UPDATE cliente SET nombre=?,apellido=?,telefono=? WHERE id_cliente=?"; try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement(sql)){ps.setString(1,n);ps.setString(2,a);ps.setString(3,t); if(id!=0)ps.setInt(4,id); ps.executeUpdate(); cargar("");}catch(Exception e){JOptionPane.showMessageDialog(this,"Error al guardar: "+e.getMessage());}}
 void editar(){int r=tabla.getSelectedRow(); if(r<0){JOptionPane.showMessageDialog(this,"Selecciona un cliente.");return;} form((int)modelo.getValueAt(r,0),modelo.getValueAt(r,1).toString(),modelo.getValueAt(r,2).toString(),modelo.getValueAt(r,3).toString());}
 void eliminar(){int r=tabla.getSelectedRow(); if(r<0){JOptionPane.showMessageDialog(this,"Selecciona un cliente.");return;} if(JOptionPane.showConfirmDialog(this,"¿Eliminar cliente?")==0) try(Connection c=Conexion.conectar(); PreparedStatement ps=c.prepareStatement("DELETE FROM cliente WHERE id_cliente=?")){ps.setInt(1,(int)modelo.getValueAt(r,0)); ps.executeUpdate(); cargar("");}catch(Exception e){JOptionPane.showMessageDialog(this,"Error: "+e.getMessage());}}
}
